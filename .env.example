# 本地单用户应用；默认不调用任何收费 API。
PORT=3210
# none | openai | pi。pi 模式使用已登录的本机 Pi，消耗该账号的模型额度。
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
# Pi 只用于无工具的剧本生成，不向模型开放 shell 或文件工具。
PI_PROVIDER=openai-codex
PI_MODEL=
# 图片生成：兼容 POST /images/generations，返回 data[].b64_json 或 https url。
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=
IMAGE_API_KEY=
# 配音：默认 macOS 系统 say；其他系统可选择 openai 或 none。
TTS_PROVIDER=auto
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_API_KEY=
# 可选：使用本机安装的 ffmpeg，替代 npm 下载的二进制。
FFMPEG_PATH=
